{% set name = "veloxchem" %}
{% set version = "@_version_@" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  path: ../../veloxchem

build:
  number: @_build_@
  entry_points:
    - vlx=veloxchem.main:main

requirements:
  build:
    - cmake >=3.18
    - {{ compiler('cxx') }}
    - libgomp  # [linux]
    - llvm-openmp  # [osx or win]
    - vs2022_win-64  # [win]
    - ninja
  host:
    - llvm-openmp  # [osx or win]
    - pybind11
    - python
    - pybind11-abi =4
    - eigen
    - libboost-headers
    - libxc-c =7.*=cpu_*
  run:
    - psutil
    - geometric
    - h5py
    - python
    - mpi4py
    - numpy
    - networkx
  run_constrained:
    - libxc-c =7.*=cpu_*

test:
  requires:
    - pytest
    - openmpi  # [linux]
    - mpich    # [osx]
    # Keep msmpi out of host so its weak run export does not pin the package
    # to MS-MPI at runtime. mpi4py then selects either the msmpi or impi_rt
    # variant, depending on which MPI backend the user requests.
    - msmpi  # [win]
    - libblas
    - dftd4-python
    - tblite-python
    - pip
    - scipy
    - openmm
    - matplotlib
    - rdkit
    - pymbar
    - mdanalysis
  source_files:
    - tests/
  imports:
    - veloxchem
  commands:
    # verify we can execute the CLI
    - vlx --version
    - vlx --help
    # inspect linkage
    - ldd -v $SP_DIR/veloxchem/veloxchemlib*.so  # [linux]
    - otool -L $SP_DIR/veloxchem/veloxchemlib*.so  # [osx]
    # prepare envvars
    - export OMPI_ALLOW_RUN_AS_ROOT=1  # [linux]
    - export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1  # [linux]
    # MPICH on macOS uses libfabric; force its TCP provider.
    - export FI_PROVIDER=tcp  # [osx]
    # run integration tests on unix-like systems
    # for now we only run selected tests on osx-arm64 due to time and resources
    # record the slowest tests to help track down CI timing changes
    # On linux, osx-arm64 and win, fast solver tests are intentionally run
    # twice: once with one MPI rank below and once with multiple MPI ranks in
    # the solver pass. The osx-arm64 parallel pass is scoped to selected solver
    # classes to keep walltime reasonable.
    - export OMP_NUM_THREADS=$CPU_COUNT  # [unix]
    - mpiexec -n 1 $PYTHON -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "not timeconsuming"  # [linux]
    - mpiexec -n 1 $PYTHON -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "not timeconsuming"  # [osx and arm64]
    - export MPI_NUM_PROCS=2  # [unix]
    - export OMP_NUM_THREADS=$(($CPU_COUNT/$MPI_NUM_PROCS))  # [unix]
    - mpiexec --bind-to none -n $MPI_NUM_PROCS $PYTHON -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "solvers and not timeconsuming"  # [linux]
    - mpiexec --bind-to none -n $MPI_NUM_PROCS $PYTHON -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "solvers and not timeconsuming" -k "TestScf or TestGrad or TestCPP or TestRPA"  # [osx and arm64]
    # run integration tests on windows
    # The serial pass covers all fast tests. The parallel pass is limited to
    # selected solver classes to keep the Windows test walltime reasonable.
    - set OMP_NUM_THREADS=%CPU_COUNT%  # [win]
    - mpiexec -n 1 %PYTHON% -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "not timeconsuming" # [win]
    - set MPI_NUM_PROCS=2  # [win]
    - set /A OMP_NUM_THREADS="%CPU_COUNT%/%MPI_NUM_PROCS%"  # [win]
    - mpiexec -n %MPI_NUM_PROCS% %PYTHON% -m pytest --capture=no --log-cli-level=INFO --durations=100 -m "solvers and not timeconsuming" -k "TestScf or TestGrad or TestCPP or TestRPA"  # [win]

about:
  home: https://veloxchem.org
  dev_url: https://github.com/VeloxChem/VeloxChem
  doc_url: https://veloxchem.org
  license: BSD 3-Clause
  license_url: https://opensource.org/license/BSD-3-Clause
  license_file:
    - LICENSE
    - LICENSE-THIRD-PARTY
  license_family: BSD
  summary: A Python-based, open source quantum chemistry program package

extra:
  recipe-maintainers:
    - robertodr
